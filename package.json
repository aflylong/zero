{
  "name": "guiling",
  "private": true,
  "version": "0.2.0",
  "description": "归零 RE:ZERO — 用一天,重启你的人生。Monorepo containing a shared core, a desktop Tauri app, and a WeChat mini-program.",
  "scripts": {
    "dev:desktop": "pnpm --filter @guiling/desktop dev",
    "build:desktop": "pnpm --filter @guiling/desktop build",
    "tauri:dev": "pnpm --filter @guiling/desktop tauri:dev",
    "tauri:build": "pnpm --filter @guiling/desktop tauri:build",
    "build:core": "pnpm --filter @guiling/core build",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "core-js",
      "vue-demi"
    ]
  }
}
